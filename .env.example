# Copia este archivo como .env y pega los valores de tu proyecto de Firebase
# (Consola de Firebase → ⚙ Configuración del proyecto → Tus apps → App web → SDK setup and configuration → Config).
# .env NUNCA se sube al repo (está en .gitignore).
# Si dejas estos valores como están, la app arranca en MODO DEMO con datos de ejemplo.

VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TU_PROYECTO
VITE_FIREBASE_STORAGE_BUCKET=TU_PROYECTO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID

# Dónde guardar las fotos de tickets:
#   firestore = gratis (plan Spark), la foto se comprime (< 900 KB) y se guarda en Firestore.
#   storage   = Firebase Storage (requiere plan Blaze con tarjeta; tiene capa gratuita).
VITE_TICKETS_BACKEND=firestore
