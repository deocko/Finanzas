rules_version = '2';

// Finanzas personales: UN solo usuario.
// 1) Reemplaza TU_CORREO@gmail.com por tu correo de Google (solo aquí, en la consola de Firebase).
//    No lo subas al repo público si no quieres: este archivo lo pegas en
//    Firebase → Firestore Database → Reglas.
// 2) Cada usuario solo puede tocar users/{su uid}/...; además, solo tu correo verificado entra.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'TU_CORREO@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if esDueno(uid);
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
